{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile with linked auth providers and username rate limiting metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique Firebase user UID"
        },
        "email": {
          "type": "string",
          "description": "Account email address"
        },
        "displayName": {
          "type": "string",
          "description": "Display name from Google or Apple"
        },
        "username": {
          "type": "string",
          "description": "Unique game handle, rate-limited to once monthly and 5 times annually"
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture avatar URL"
        },
        "providers": {
          "type": "string",
          "description": "Comma separated linked auth providers (e.g. google.com, apple.com)"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation ISO timestamp"
        },
        "lastUsernameChangeAt": {
          "type": "string",
          "description": "Timestamp of the most recent username change"
        },
        "usernameChangesThisYear": {
          "type": "number",
          "description": "Count of username modifications during the current rolling year"
        },
        "annualQuotaRemaining": {
          "type": "number",
          "description": "Remaining username changes allowed this year (max 5)"
        }
      },
      "required": ["id", "username"]
    },
    "UsernameRecord": {
      "title": "UsernameRecord",
      "description": "Unique handle lookup index to ensure no duplicate usernames",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Lowercased username"
        },
        "userId": {
          "type": "string",
          "description": "Owning user UID"
        },
        "claimedAt": {
          "type": "string",
          "description": "Claim timestamp"
        }
      },
      "required": ["username", "userId"]
    },
    "CRMIssue": {
      "title": "CRMIssue",
      "description": "User reported bug or simulation anomaly logged to CRM",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Reporting user ID" },
        "username": { "type": "string", "description": "User handle" },
        "issueCategory": { "type": "string", "description": "Issue classification" },
        "severity": { "type": "string", "description": "Severity level" },
        "errorMessage": { "type": "string", "description": "User description" },
        "status": { "type": "string", "description": "OPEN, RESOLVED, etc." }
      },
      "required": ["userId", "errorMessage"]
    },
    "BetaFeedback": {
      "title": "BetaFeedback",
      "description": "Beta player scouting report, bug submission, or balance tuning feedback",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Reporting user ID" },
        "userEmail": { "type": "string", "description": "Account email address" },
        "username": { "type": "string", "description": "Display name or GM handle" },
        "category": { "type": "string", "description": "BUG, BALANCE, FEATURE_REQUEST, CARD_ART, GENERAL" },
        "subject": { "type": "string", "description": "Topic or summary of the report" },
        "description": { "type": "string", "description": "Detailed explanation" },
        "rating": { "type": "number", "description": "Gameplay satisfaction rating 1 to 5" },
        "status": { "type": "string", "description": "NEW, TRIAGED, IN_PROGRESS, RESOLVED" }
      },
      "required": ["userId", "category", "subject", "description"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual player profiles, linked accounts, and username history"
    },
    "/usernames/{usernameLower}": {
      "schema": "UsernameRecord",
      "description": "Global unique username reservation index"
    },
    "/crm_issues/{issueId}": {
      "schema": "CRMIssue",
      "description": "Scout CRM Copilot tickets and user bug reports"
    },
    "/beta_feedback/{feedbackId}": {
      "schema": "BetaFeedback",
      "description": "Beta GM scouting reports and gameplay balance feedback"
    }
  }
}
